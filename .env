# ──────────────────────────────────────────────
#  PrediCasa - Variables de entorno
#  Copia este archivo como .env y completa los valores
# ──────────────────────────────────────────────

# ── AIRFLOW ──
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=faT1P3lN-rD_h--JS4UCnWzrMeC6u9x5PNhzFHI7mGQ=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=predicasa_secret_2026
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=mysql+pymysql://airflow:airflow@mysql:3306/airflow

# ── MYSQL (backend de Airflow) ──
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=airflow
MYSQL_USER=airflow
MYSQL_PASSWORD=airflow

# ── MLFLOW ──
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── GCP / BIGQUERY ──
GCP_PROJECT=pruebahabi
GCP_CREDENTIALS_PATH=./secrets/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json

# ── PIPELINE - GCS ──
GCS_BUCKET_NAME=habibucket
GCS_PREFIX_LANDING=landing
GCS_PREFIX_PROCESSING=processing
GCS_PREFIX_PROCESSED=processed

# ── PIPELINE - BIGQUERY DATASETS ──
BQ_DATASET_CONFIG=config
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_CONSUMPTION=consumption

# ── PIPELINE - AUDITORIA ──
BQ_FUENTE_RAW=carga_raw
BQ_FUENTE_STAGING=transformacion_raw_staging
BQ_FUENTE_CONSUMPTION=consumption_ml

# ── PIPELINE - ML ──
ML_PCT_TRAIN=80
ML_PRECIO_MIN=10000000

# ── PIPELINE - API REST paginada (estandar SODA / Socrata) ──
# Opcional: sin token la API igual funciona, con un limite de peticiones menor.
SODA_APP_TOKEN=
